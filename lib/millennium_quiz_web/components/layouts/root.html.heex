<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#eef2f7" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Millennium Quiz" suffix=" · Millennium Quiz" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/millennium-puzzle.svg"} />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <%!-- the site's fonts (headings, body) and the card faces: fetched with the CSS
         instead of after it (fonts need crossorigin) --%>
    <link rel="preload" as="font" type="font/woff2" href={~p"/fonts/Orbitron.woff2"} crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/Rajdhani-500.woff2"}
      crossorigin
    />
    <link rel="preload" as="font" type="font/woff2" href={~p"/fonts/Cinzel.woff2"} crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/CrimsonPro.woff2"}
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        // the browser bar follows the site's theme, not only the system's
        const barColors = {light: "#fdfaf4", dark: "#19182a", "duel-light": "#eef2f7", "duel-dark": "#0b0f16"};
        const paintBar = () => {
          const color = barColors[document.documentElement.getAttribute("data-theme")];
          if (color) document.querySelector("meta[name=theme-color]")?.setAttribute("content", color);
        };

        // The duel theme is the site's look: "system" and "duel" (no stored choice) follow
        // the system's light or dark; "duel-light" / "duel-dark" are fixed. Old visitors
        // may have stored "light" or "dark" (the former Millennium themes): they get the
        // duel variant. "millennium-light" / "millennium-dark" (only by ?theme=) still
        // select the old themes, which have no button.
        const aliases = {light: "duel-light", dark: "duel-dark", system: "duel"};
        const fixed = ["duel-light", "duel-dark", "millennium-light", "millennium-dark"];
        const known = ["system", "duel", "light", "dark", ...fixed];
        const resolve = () => "duel-" + systemTheme();
        const setTheme = (theme) => {
          theme = known.includes(theme) ? (aliases[theme] || theme) : "duel";
          const root = document.documentElement;
          if (theme === "duel") {
            localStorage.removeItem("phx:theme");
            root.setAttribute("data-theme", resolve());
            root.setAttribute("data-theme-family", theme);
            root.setAttribute("data-theme-source", "system");
          } else {
            root.setAttribute("data-theme-family", "fixed");
            localStorage.setItem("phx:theme", theme);
            root.setAttribute("data-theme", theme.replace("millennium-", ""));
            root.setAttribute("data-theme-source", "user");
          }
          paintBar();
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          const asked = new URLSearchParams(location.search).get("theme");
          setTheme(known.includes(asked) ? asked : localStorage.getItem("phx:theme"));
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", resolve());
            paintBar();
          }
        });
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-base-200/40">
    <%!-- The shape of the Synchro ring (`DuelComponents.synchro_ring/1`), defined once.
         12 identical dashes: pathLength 96, dash 5 + gap 3. The colours are CSS variables
         (as style, because var() does not work in a presentation attribute). --%>
    <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
      <symbol id="duel-ring" viewBox="0 0 64 64">
        <g transform="rotate(-98.75 32 32)">
          <circle
            cx="32"
            cy="32"
            r="29"
            fill="none"
            stroke-width="5"
            pathLength="96"
            stroke-dasharray="5 3"
            style="stroke: var(--duel-sync, #5dff7a)"
          />
        </g>
        <circle
          cx="32"
          cy="32"
          r="24.5"
          fill="none"
          stroke-width="1.2"
          opacity=".8"
          style="stroke: var(--duel-ring-inner, #19d3ff)"
        />
      </symbol>
    </svg>
    {@inner_content}
  </body>
</html>
