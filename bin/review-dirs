# shellcheck shell=bash
# Where the review files live. Sourced by every bin/review-* script that
# touches reviews/, so they all agree.
#
# reviews_dir is always <main checkout>/reviews, no matter which worktree the
# command runs from. In the primary tree it is the top level. From a linked
# worktree it is the parent of git's common dir when that is named .git and
# that parent really is a work tree with that common dir. With a separate git dir or a submodule it is only known
# from the primary tree itself; from a linked worktree of such a repo, and in a
# bare repository, sourcing fails with a message and reviews_dir stays unset.
# Reviews therefore survive removing a worktree. reviews_dir/archive and
# reviews_dir/logs live under it.
# Throwaway PR worktrees, .review/ and REVIEWING.md stay relative to the
# checkout the command runs from.
#
# Reviews that an older version left in another worktree's own reviews/ are
# not moved. Once per run (REVIEW_STRAY_NOTICED), a notice names them and
# suggests mv -n commands for the files that do not clash with one already in
# the main checkout; clashing files are listed for manual handling and are
# never overwritten or deleted. Only emptied directories are removed.
# Nothing is moved or deleted automatically.
#
# Why not `git worktree list --porcelain` (first entry = main worktree)? Tried
# (git 2.43): in a repo made with --separate-git-dir the first entry is the git
# dir itself, not the working tree, and in a bare repo it is the bare dir (marked
# "bare"). So it does not give the main checkout in exactly the layouts where
# <common dir>/.. does not either.

# Is $1 a work tree whose own git dir is the common dir $2?
_review_is_checkout_of() {
  local cand="$1" common="$2" g="env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR git -C $1"
  [[ "$($g rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" == "$common" ]] &&
    [[ "$($g rev-parse --show-toplevel 2>/dev/null)" == "$cand" ]]
}

review_main_checkout() {
  local common gitdir main
  if [[ "$(git rev-parse --is-bare-repository 2>/dev/null)" == true ]]; then
    echo "review-dirs: bare repository; there is no main checkout to keep reviews/ in" >&2
    return 1
  fi
  common="$(git rev-parse --path-format=absolute --git-common-dir)" || return 1
  gitdir="$(git rev-parse --path-format=absolute --git-dir)" || return 1
  if [[ "$gitdir" == "$common" ]]; then
    # Run from the primary tree itself (also a separate git dir or submodule).
    main="$(git rev-parse --show-toplevel)" || return 1
  elif [[ "$(basename "$common")" == .git ]] && _review_is_checkout_of "$(dirname "$common")" "$common"; then
    # Linked worktree: <common dir>/.. really is a work tree whose own .git is
    # that common dir.
    main="$(dirname "$common")"
  else
    echo "review-dirs: cannot find the main checkout: the git dir ($common) is not <checkout>/.git; run the command from the main checkout" >&2
    return 1
  fi
  if [[ -z "$main" || "$main" != /* ]]; then
    echo "review-dirs: cannot determine the main checkout (got '${main}')" >&2
    return 1
  fi
  printf '%s\n' "$main"
}

review_notice_stray() {
  local main_reviews="$1" top
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  [[ -d "$top/reviews" && "$top/reviews" != "$main_reviews" ]] || return 0
  [[ "$(cd "$top/reviews" && pwd -P)" != "$(cd "$main_reviews" 2>/dev/null && pwd -P)" ]] || return 0
  [[ -z "${REVIEW_STRAY_NOTICED:-}" ]] || return 0
  local files f rel clash="" move="" q
  files="$(find "$top/reviews" -type f 2>/dev/null | sort)" || true
  [[ -n "$files" ]] || return 0
  export REVIEW_STRAY_NOTICED=1
  while IFS= read -r f; do
    rel="${f#"$top/reviews/"}"
    if [[ -e "$main_reviews/$rel" || -L "$main_reviews/$rel" ]]; then
      clash+="  $f"$'\n'
    else
      printf -v q 'mkdir -p %q && mv -n %q %q' \
        "$(dirname "$main_reviews/$rel")" "$f" "$main_reviews/$rel"
      move+="  $q"$'\n'
    fi
  done <<<"$files"
  {
    echo "review-dirs: reviews now live in $main_reviews, but this worktree still has:"
    sed 's/^/  /' <<<"$files"
    echo "These are not seen by the review scripts."
    if [[ -n "$clash" ]]; then
      echo "These already exist in the main checkout; compare and merge them by hand (they are not touched by the commands below):"
      printf '%s' "$clash"
    fi
    if [[ -n "$move" ]]; then
      echo "To keep the others, run (mv -n never overwrites):"
      printf '%s' "$move"
    fi
    printf 'Then remove the emptied directories (files that are left stay):\n  find %q -depth -type d -empty -delete\n' "$top/reviews"
  } >&2
}

if reviews_dir="$(review_main_checkout)"; then
  reviews_dir+=/reviews
  # the notice is optional: it must never abort a `set -e` caller
  review_notice_stray "$reviews_dir" || true
else
  unset reviews_dir
  return 1
fi
