#!/usr/bin/env bash
# Reviews one pull request in a separate, isolated Claude Code process.
#
#   bin/review-pr <number> [--force]
#
# The reviewer's instructions and model come from .claude/agents/pr-reviewer.md.
# It runs inside a throwaway worktree of the PR's head commit with the flags in
# bin/review-flags: only Read, Grep and Glob (no shell, no Write/Edit, no MCP),
# confined to that worktree, no settings, no saved session. bin/review-selfcheck
# verifies that this isolation holds with the installed Claude Code. As
# --restricted skips project agents, the instructions are passed with
# --append-system-prompt.
#
# The reviewer must be a different model family than the one that wrote the PR
# (from the commits' "Co-Authored-By: Claude <model>" trailers); this is checked
# before the run and again against the model that actually answered.
#
# Everything it needs is prepared as files in <worktree>/.review/: the diff
# (with head line numbers) and commits against the merge base, the PR
# description, REVIEWING.md from this checkout, and the CI results of the head
# commit (tests, coverage, compile warnings; see .github/workflows/ci.yml), so it
# can check test results without running any code. Its prompt is fixed: the PR
# number and the two commits. Afterwards every cited path:line is checked
# against the head commit.
#
# Output: reviews/pr-<branch>.md, one current review per PR (the branch name
# with characters other than letters, digits, ".", "_" and "-" replaced by "-").
# A new review moves the previous one, with its verdicts, to reviews/archive/.
# Exit codes: 0 reviewed, 3 skipped (the current review is of this commit), 1 failed.
# Environment: REVIEW_MODEL (default: the model in the agent file),
# REVIEW_SELFCHECKED=1 to skip the self-check (bin/review-open-prs runs it once),
# REVIEW_CLEANED=1 to skip archiving reviews of merged/closed PRs (likewise),
# REVIEW_CI_WAIT (default 900): seconds to wait for a CI run still in progress.
set -euo pipefail

usage() { echo "usage: bin/review-pr <number> [--force]" >&2; exit 1; }

number=""
force=false
for arg in "$@"; do
  case "$arg" in
    --force) force=true ;;
    [0-9]*) number="$arg" ;;
    *) usage ;;
  esac
done
[[ -n "$number" ]] || usage

root="$(git rev-parse --show-toplevel)"
cd "$root"
# shellcheck source=bin/review-flags
source bin/review-flags

agent=".claude/agents/pr-reviewer.md"
[[ -f "$agent" ]] || { echo "review-pr: $agent not found" >&2; exit 1; }
# Body = everything after the closing "---" of the frontmatter.
instructions="$(awk 'f>=2 {print} /^---$/ {f++}' "$agent")"
model="${REVIEW_MODEL:-$(sed -n 's/^model: *//p' "$agent" | head -1)}"
model="${model:-sonnet}"

for tool in gh claude git python3; do
  command -v "$tool" >/dev/null || { echo "review-pr: $tool not found" >&2; exit 1; }
done

pr=$(gh pr view "$number" --json number,title,headRefOid,baseRefOid,baseRefName,headRefName,isDraft,url \
  --jq '[.headRefOid, .baseRefOid, .baseRefName, .headRefName, (.isDraft|tostring), .url, .title] | join("\t")') ||
  { echo "review-pr: PR #$number not found" >&2; exit 1; }
IFS=$'\t' read -r head base_tip base_branch branch draft url title <<<"$pr"

short="${head:0:7}"
slug="$(printf '%s' "$branch" | sed 's/[^A-Za-z0-9._-]/-/g')"
mkdir -p reviews
out="reviews/pr-${slug}.md"
reviewed_head() { sed -n 's/^- Head: `\([0-9a-f]*\)`.*/\1/p' "$1" | head -1; }

if [[ -e "$out" && "$force" != true && "$(reviewed_head "$out")" == "$head" ]]; then
  echo "skipped: PR #$number at $short already reviewed ($out); use --force to review again"
  exit 3
fi

# Make sure both commits are here (the PR may come from a branch we never fetched).
if ! git cat-file -e "${head}^{commit}" 2>/dev/null || ! git cat-file -e "${base_tip}^{commit}" 2>/dev/null; then
  git fetch --quiet origin "+refs/pull/${number}/head:refs/remotes/origin/pr/${number}" "$base_branch"
fi

# The base branch may have moved on since the PR branched off; diffing against
# its tip would show those newer commits as reversed changes of the PR.
base="$(git merge-base "$base_tip" "$head")"

# The reviewer must not share the author's blind spots: refuse a model of the
# same family as any Claude model that co-authored the PR's commits.
authors="$(bin/review-tools authors "$base" "$head")"
reviewer_family="$(bin/review-tools family "$model")"
if [[ " $authors " == *" $reviewer_family "* ]]; then
  echo "review-pr: PR #$number was written with Claude ${authors// /, }; the reviewer must be another model than $model (e.g. REVIEW_MODEL=$( [[ $reviewer_family == sonnet ]] && echo fable || echo sonnet))" >&2
  exit 1
fi

# Reviews of PRs that are merged or closed don't belong in reviews/ anymore.
if [[ "${REVIEW_CLEANED:-}" != 1 ]]; then
  bin/review-cleanup
fi

if [[ "${REVIEW_SELFCHECKED:-}" != 1 ]]; then
  bin/review-selfcheck || { echo "review-pr: reviewer isolation not verified, not reviewing" >&2; exit 1; }
fi

worktree="$root/.claude/worktrees/pr-${slug}-$$"
tmp="$(mktemp)"
run="$(mktemp)"
cleanup() {
  git worktree remove --force "$worktree" >/dev/null 2>&1 || true
  rm -f "$tmp" "$run"
}
trap cleanup EXIT

git worktree add --quiet --detach "$worktree" "$head"

# The review material, so the reviewer needs no shell or network.
material="$worktree/.review"
mkdir -p "$material"
cp REVIEWING.md "$material/REVIEWING.md"
git log --reverse --format='%h %s%n%n%b' "$base..$head" >"$material/commits.txt"
git diff --stat "$base" "$head" >"$material/files.txt"
git diff "$base" "$head" | bin/review-tools annotate-diff >"$material/diff.patch"
gh pr view "$number" --json title,body --jq '"# " + .title + "\n\n" + .body' >"$material/description.md"

# CI results of the head commit (the reviewer must not run code itself).
ci_run() {
  gh run list --commit "$head" --workflow CI --limit 1 --json databaseId,status,conclusion,url \
    --jq '.[0] // empty | [(.databaseId|tostring), .status, .conclusion, .url] | join("\t")' 2>/dev/null || true
}
ci="$(ci_run)"
if [[ -n "$ci" && "$(cut -f2 <<<"$ci")" != completed ]]; then
  echo "waiting for CI of $short (up to ${REVIEW_CI_WAIT:-900}s)…"
  timeout "${REVIEW_CI_WAIT:-900}" gh run watch "$(cut -f1 <<<"$ci")" --exit-status >/dev/null 2>&1 || true
  ci="$(ci_run)"
fi
if [[ -z "$ci" ]]; then
  ci_status="no CI run for this commit"
  echo "No CI run exists for the head commit, so there are no test results." >"$material/tests.md"
else
  IFS=$'\t' read -r ci_id ci_state ci_conclusion ci_url <<<"$ci"
  if [[ "$ci_state" != completed ]]; then
    ci_status="still running ($ci_url)"
    echo "CI is still running for the head commit ($ci_url); no test results yet." >"$material/tests.md"
  elif gh run download "$ci_id" -n ci-results -D "$material/ci" >/dev/null 2>&1; then
    ci_status="$ci_conclusion ($ci_url)"
    { echo "CI run: $ci_conclusion — $ci_url"
      echo
      echo "For pull requests, CI tests a temporary merge commit of the head commit"
      echo "\`${head}\` into \`${base_branch}\`. The \"CI results for <sha>\" line below names"
      echo "that merge commit, not the head: the results are for this PR's code."
      echo; cat "$material/ci/summary.md"
      echo; echo "Full outputs: .review/ci/tests.txt (tests and coverage), compile.txt,"
      echo "unused-deps.txt, format.txt."; } >"$material/tests.md"
  else
    ci_status="$ci_conclusion, results not downloadable ($ci_url)"
    echo "CI run: $ci_conclusion — $ci_url (the ci-results artifact could not be downloaded)." >"$material/tests.md"
  fi
fi

prompt="Review pull request #${number} (branch ${branch} into ${base_branch}).
Base commit (merge base): ${base}
Head commit: ${head}
The working directory is a read-only checkout of the head commit; the review
material is in .review/. Follow your review procedure and output only the review."

echo "reviewing PR #$number ($short) with $model…"
if ! (cd "$worktree" && claude -p "$prompt" \
  --append-system-prompt "$instructions" \
  --model "$model" \
  "${review_flags[@]}" \
  --output-format json </dev/null >"$run") ||
  ! used="$(bin/review-tools run-result "$run" "$tmp")" || [[ ! -s "$tmp" ]]; then
  echo "review-pr: the reviewer failed for PR #$number" >&2
  exit 1
fi

# Check the models that actually answered, too (e.g. no silent fallback).
for m in $used; do
  if [[ " $authors " == *" $(bin/review-tools family "$m") "* ]]; then
    echo "review-pr: the review was answered by $m, the same family as the author; not saved" >&2
    exit 1
  fi
done

# Keep the previous review (and the verdicts ticked in it) in the archive.
if [[ -e "$out" ]]; then
  mkdir -p reviews/archive
  old="reviews/archive/pr-${slug}-$(reviewed_head "$out" | cut -c1-7).md"
  [[ -e "$old" ]] && old="${old%.md}-$(date -u +%Y%m%dT%H%M%S).md"
  mv "$out" "$old"
fi

{
  echo "# Review of PR #${number}: ${title}"
  echo
  echo "- PR: #${number} ${url}$([[ "$draft" == true ]] && echo " (draft)")"
  echo "- Branch: \`${branch}\`"
  echo "- Base: \`${base}\` (merge base with \`${base_branch}\`)"
  echo "- Head: \`${head}\`"
  echo "- Reviewer: ${used//$'\n'/, } (bin/review-pr, isolated process)"
  echo "- Written with: ${authors:-no Claude model in the commits}"
  echo "- CI: ${ci_status}"
  echo "- Date: $(date -u +%Y-%m-%dT%H:%MZ)"
  echo
  # Anything the reviewer wrote before its summary is narration, not review.
  if grep -q '^## Summary' "$tmp"; then sed -n '/^## Summary/,$p' "$tmp"; else cat "$tmp"; fi
} >"$out"

# The verdict lines are what the user ticks and /post-review reads; add any the
# reviewer left out.
verdict='- **Your verdict:** [ ] valid  [ ] wrong  [ ] unsure — reason:'
awk -v verdict="$verdict" '
  function flush() {
    if (n == 0) return
    if (finding && !has) {
      while (n > 0 && buf[n] == "") n--
      buf[++n] = verdict; buf[++n] = ""
    }
    for (i = 1; i <= n; i++) print buf[i]
    n = 0; has = 0
  }
  /^##/ { flush(); finding = ($0 ~ /^### F[0-9]+ /) }
  { buf[++n] = $0; if (index($0, "Your verdict")) has = 1 }
  END { flush() }
' "$out" >"$tmp" && cat "$tmp" >"$out"

# Every cited path:line must exist at the head commit; flag those that don't.
bad="$(bin/review-tools check-locations "$out" "$head")"

count() { grep -cE "^### F[0-9]+ · $1 " "$out" || true; }
echo "reviewed: $out — blocker $(count blocker), should-fix $(count should-fix), nit $(count nit), question $(count question)$([[ $bad != 0 ]] && echo ", $bad location(s) flagged")"
