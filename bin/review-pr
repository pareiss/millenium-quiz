#!/usr/bin/env bash
# Reviews one pull request in a separate, isolated Claude Code process.
#
#   bin/review-pr <number> [--force]
#
# The reviewer's instructions and model come from .claude/agents/pr-reviewer.md.
# It runs inside a throwaway worktree of the PR's head commit, with only Read,
# Grep and Glob: no shell, no Write or Edit, so it can't change anything, and
# --restricted keeps it inside that worktree. --restricted also skips all
# user/project/local settings (so the project agents too: the instructions are
# passed with --append-system-prompt), and nothing is saved as a session.
#
# Everything it needs is prepared as files in <worktree>/.review/: the diff and
# commits against the merge base, the PR description, and REVIEWING.md from
# this checkout. Its prompt is fixed: the PR number and the two commits.
#
# Output: reviews/pr-<branch>-<short head sha>-<model>.md (the branch name with
# characters other than letters, digits, ".", "_" and "-" replaced by "-").
# Exit codes: 0 reviewed, 3 skipped (this commit was already reviewed), 1 failed.
# Environment: REVIEW_MODEL (default: the model in the agent file).
set -euo pipefail

usage() { echo "usage: bin/review-pr <number> [--force]" >&2; exit 1; }

number=""
force=false
for arg in "$@"; do
  case "$arg" in
    --force) force=true ;;
    [0-9]*) number="$arg" ;;
    *) usage ;;
  esac
done
[[ -n "$number" ]] || usage

root="$(git rev-parse --show-toplevel)"
cd "$root"

agent=".claude/agents/pr-reviewer.md"
[[ -f "$agent" ]] || { echo "review-pr: $agent not found" >&2; exit 1; }
# Body = everything after the closing "---" of the frontmatter.
instructions="$(awk 'f>=2 {print} /^---$/ {f++}' "$agent")"
model="${REVIEW_MODEL:-$(sed -n 's/^model: *//p' "$agent" | head -1)}"
model="${model:-sonnet}"

for tool in gh claude git; do
  command -v "$tool" >/dev/null || { echo "review-pr: $tool not found" >&2; exit 1; }
done

pr=$(gh pr view "$number" --json number,title,headRefOid,baseRefOid,baseRefName,headRefName,isDraft,url \
  --jq '[.headRefOid, .baseRefOid, .baseRefName, .headRefName, (.isDraft|tostring), .url, .title] | join("\t")') ||
  { echo "review-pr: PR #$number not found" >&2; exit 1; }
IFS=$'\t' read -r head base_tip base_branch branch draft url title <<<"$pr"

short="${head:0:7}"
slug="$(printf '%s' "$branch" | sed 's/[^A-Za-z0-9._-]/-/g')"
mkdir -p reviews
out="reviews/pr-${slug}-${short}-${model}.md"

if [[ -e "$out" && "$force" != true ]]; then
  echo "skipped: PR #$number at $short already reviewed ($out); use --force to review again"
  exit 3
fi

# Make sure both commits are here (the PR may come from a branch we never fetched).
if ! git cat-file -e "${head}^{commit}" 2>/dev/null || ! git cat-file -e "${base_tip}^{commit}" 2>/dev/null; then
  git fetch --quiet origin "+refs/pull/${number}/head:refs/remotes/origin/pr/${number}" "$base_branch"
fi

# The base branch may have moved on since the PR branched off; diffing against
# its tip would show those newer commits as reversed changes of the PR.
base="$(git merge-base "$base_tip" "$head")"

worktree="$root/.claude/worktrees/pr-${slug}-$$"
tmp="$(mktemp)"
cleanup() {
  git worktree remove --force "$worktree" >/dev/null 2>&1 || true
  rm -f "$tmp"
}
trap cleanup EXIT

git worktree add --quiet --detach "$worktree" "$head"

# The review material, so the reviewer needs no shell or network.
material="$worktree/.review"
mkdir -p "$material"
cp REVIEWING.md "$material/REVIEWING.md"
git log --reverse --format='%h %s%n%n%b' "$base..$head" >"$material/commits.txt"
git diff --stat "$base" "$head" >"$material/files.txt"
git diff "$base" "$head" >"$material/diff.patch"
gh pr view "$number" --json title,body --jq '"# " + .title + "\n\n" + .body' >"$material/description.md"

prompt="Review pull request #${number} (branch ${branch} into ${base_branch}).
Base commit (merge base): ${base}
Head commit: ${head}
The working directory is a read-only checkout of the head commit; the review
material is in .review/. Follow your review procedure and output only the review."

echo "reviewing PR #$number ($short) with $model…"
if ! (cd "$worktree" && claude -p "$prompt" \
  --append-system-prompt "$instructions" \
  --model "$model" \
  --restricted \
  --no-session-persistence \
  --tools "Read,Grep,Glob" \
  --allowedTools "Read Grep Glob" \
  --output-format text </dev/null >"$tmp") || [[ ! -s "$tmp" ]]; then
  echo "review-pr: the reviewer failed for PR #$number" >&2
  exit 1
fi

{
  echo "# Review of PR #${number}: ${title}"
  echo
  echo "- PR: #${number} ${url}$([[ "$draft" == true ]] && echo " (draft)")"
  echo "- Branch: \`${branch}\`"
  echo "- Base: \`${base}\` (merge base with \`${base_branch}\`)"
  echo "- Head: \`${head}\`"
  echo "- Reviewer: ${model} (bin/review-pr, isolated process)"
  echo "- Date: $(date -u +%Y-%m-%dT%H:%MZ)"
  echo
  # Anything the reviewer wrote before its summary is narration, not review.
  if grep -q '^## Summary' "$tmp"; then sed -n '/^## Summary/,$p' "$tmp"; else cat "$tmp"; fi
} >"$out"

# The verdict lines are what the user ticks and /post-review reads; add any the
# reviewer left out.
verdict='- **Your verdict:** [ ] valid  [ ] wrong  [ ] unsure — reason:'
awk -v verdict="$verdict" '
  function flush() {
    if (n == 0) return
    if (finding && !has) {
      while (n > 0 && buf[n] == "") n--
      buf[++n] = verdict; buf[++n] = ""
    }
    for (i = 1; i <= n; i++) print buf[i]
    n = 0; has = 0
  }
  /^##/ { flush(); finding = ($0 ~ /^### F[0-9]+ /) }
  { buf[++n] = $0; if (index($0, "Your verdict")) has = 1 }
  END { flush() }
' "$out" >"$tmp" && cat "$tmp" >"$out"

count() { grep -cE "^### F[0-9]+ · $1 " "$out" || true; }
echo "reviewed: $out — blocker $(count blocker), should-fix $(count should-fix), nit $(count nit), question $(count question)"
