#!/usr/bin/env python3
"""Layout smoke test: tablet and phone viewports in a headless browser.

    bin/layout-test [URL]            # default: $LAYOUT_URL or http://localhost:4000

Needs the "Layout check" format (priv/repo/layout_fixture.exs: `mix run
priv/repo/layout_fixture.exs`, or `Release.seed_layout_fixture()` in a release)
and Playwright with Chromium:

    python3 -m venv .venv-layout && .venv-layout/bin/pip install -r bin/layout-test-requirements.txt
    .venv-layout/bin/playwright install chromium
    .venv-layout/bin/python bin/layout-test

It plays one game of that format, creating a game on the site it is pointed at
(so not for the live site), and resizes the window through the viewports.
Checks the question view (docs/plans/tablet-phone-layout.md):
  - no horizontal overflow, on the board and in the question
  - cards per row: 4 on a portrait tablet, 3 on a landscape one, 2 on a phone
  - the cards of player 1 and 2 have a blue / red ring with a fading glow and a badge, their links in the
    text are blue / red (and none of it breaks the cards-per-row or overflow checks)
  - the {P1} / {P2} badges of the question text are shown, blue and red
  - the players' pictures (monster faces) on the board are shown and loaded
  - the score line is on the board and gone in the question, except on a large screen
    (1600x900 and up), where the player list stays with the question and the
    pass-the-device bar does not fold; the page grows with the screen above 1920x1080 (limited by the height too)
  - the site's top bar is gone in the question when the screen is at most 920px
    high, and stays on a tall tablet
  - the answer fields of /suggest have no card list (a suggestion has no cards), only the hint
  - the pass-the-device bar goes by itself in about 3 seconds, for the first player and again
    for the next: on a phone or tablet it folds away while the choices wait (locked, dimmed,
    a not-allowed pointer, a running line); on a large screen it fades where it is, nothing
    moves and nothing is locked
  - how far the question must scroll stays under a limit per viewport
  - new-game page, on a touch context: the players' picture buttons are >= 44px, the open picture panel fits
    the width with a capped, scrolling grid of >= 44px targets, choosing a picture changes the button
  - the life-point duel (format "LP duel fixture"): the Life Points choice of the new-game page (cards >= 44px), the
    board with 2, 3 and 4 players (life points and bars on screen), the result screen with a K.O., the final ranking,
    and the Level Up! topic buttons with "NEXT ATK" (>= 44px at every width down to 320px)
  - with SMOKE_ADMIN_USER / SMOKE_ADMIN_PASSWORD: the admin question rows show their ATK badge and the form its
    fixed-damage note (no points field), on screen at every viewport; the question form has up and down buttons
    for the cards, on screen at every viewport, and they move a card (nothing is saved);
    every admin page (formats, new/edit format, format page, profile pictures, question form, suggestions, admins,
    backup) at every viewport: no horizontal overflow, no cut-off text, every control >= 44px on touch viewports
    (up to 1180px wide), a long question text in the format page's rows wraps;
    LAYOUT_REQUIRE_ADMIN=1 (CI) makes missing credentials a failure instead of a skip.
    It logs in on the site it is pointed at, so use the throwaway site of CI or a local fixture, not a real one
Exit code: 0 all passed, 1 at least one check failed.
"""
import os
import sys

from playwright.sync_api import TimeoutError as PlaywrightTimeout
from playwright.sync_api import sync_playwright

# LAYOUT_THEME=duel-dark (or duel-light, light, dark) runs everything under that theme
# (the choice a visitor keeps in localStorage 'phx:theme'); unset is the site's default.
THEME = os.environ.get("LAYOUT_THEME", "")

base = (sys.argv[1] if len(sys.argv) > 1 else os.environ.get("LAYOUT_URL", "http://localhost:4000")).rstrip("/")

# name, width, height, cards per row (at least), most scrolling allowed in px.
# The question has 4 cards, the worst case: on a phone they take two rows. The
# limits are the measured values plus a margin, to catch a regression, not a goal.
VIEWPORTS = [
    ("tablet 768x1024", 768, 1024, 4, 0),
    ("tablet 810x1080", 810, 1080, 4, 0),
    ("tablet 820x1180", 820, 1180, 4, 0),
    ("tablet 834x1194", 834, 1194, 4, 0),
    ("tablet 912x1368", 912, 1368, 4, 0),
    ("tablet landscape 1024x768", 1024, 768, 3, 100),
    ("tablet landscape 1180x820", 1180, 820, 3, 100),
    ("phone 412x915", 412, 915, 2, 250),
    ("phone 390x844", 390, 844, 2, 290),
    ("phone 360x740", 360, 740, 2, 430),
    ("phone 320x568", 320, 568, 2, 560),
    ("phone landscape 844x390", 844, 390, 2, 450),
    # large screens: a monitor, a 4K one at 100% (1600x900 and up, see app.css); the
    # sizes are browser windows: the 1080p monitor's is about 1920x950
    ("desktop window 1920x950", 1920, 950, 4, 0),
    ("desktop 1920x1080", 1920, 1080, 4, 0),
    ("small monitor 1600x900", 1600, 900, 4, 0),
    ("monitor 2560x1440", 2560, 1440, 4, 0),
    ("ultrawide 3440x1440", 3440, 1440, 4, 0),
    ("4K 3840x2160", 3840, 2160, 4, 0),
    # wide but short: not a large screen, and the page must not grow with the width
    ("short and wide 2560x800", 2560, 800, 4, 0),
]


def is_large(w, h):
    return w >= 1600 and h >= 900


def root_font(w, h):
    """The root font size of app.css: max(16px, min(0.8333vw, 1.4815vh))."""
    return max(16, min(w * 0.008333, h * 0.014815))

passed = 0
failed = 0


def check(label, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
        print(f"  ok    {label}")
    else:
        failed += 1
        print(f"  FAIL  {label}" + (f" ({detail})" if detail else ""))


def metrics(page):
    return page.evaluate(
        """() => {
          const cards = [...document.querySelectorAll('#question-cards article')]
          const firstTop = cards.length ? Math.round(cards[0].getBoundingClientRect().top) : null
          const header = document.querySelector('#site-header')
          return {
            overX: document.documentElement.scrollWidth - document.documentElement.clientWidth,
            overY: document.documentElement.scrollHeight - innerHeight,
            perRow: cards.filter(c => Math.round(c.getBoundingClientRect().top) === firstTop).length,
            header: header ? getComputedStyle(header).display : 'missing',
            // the list is in the page during a question, hidden by css below 1600x1000
            score: (() => { const e = document.querySelector('#scoreboard'); return !!e && getComputedStyle(e).display !== 'none' })(),
            rootFont: parseFloat(getComputedStyle(document.documentElement).fontSize),
            // the ring and glow of an owned card are shadows of its face: ring colour and
            // width, glow colour, the badge inside the screen, and the clear space between
            // the rings of two owned cards side by side (their gap less both rings)
            owned: (() => {
              const els = [...document.querySelectorAll('#question-cards [data-owner]')]
              const info = els.map(e => {
                const shadow = getComputedStyle(e.querySelector('.mq-card__face')).boxShadow
                const ring = shadow.match(/(rgb\(\d+, \d+, \d+\)) 0px 0px 0px ([\d.]+)px/)
                const glow = shadow.match(/rgba\((\d+, \d+, \d+), ([\d.]+)\) 0px 0px ([\d.]+)px ([\d.]+)px/)
                const b = e.querySelector('.mq-owner-badge').getBoundingClientRect()
                return {owner: e.dataset.owner, ring: ring && ring[1], ringPx: ring ? parseFloat(ring[2]) : 0,
                        glow: glow && glow[1], glowAlpha: glow ? parseFloat(glow[2]) : 0,
                        badgeIn: b.left >= 0 && b.right <= innerWidth && b.width > 0,
                        box: e.closest('article').getBoundingClientRect()} // not the card: it lifts under the mouse
              })
              const [a, c] = info
              const sameRow = a && c && Math.round(a.box.top) === Math.round(c.box.top)
              return {
                cards: info.map(i => [i.owner, i.ring, i.glow, i.glowAlpha > 0.3, i.ringPx >= 0.7, i.badgeIn]),
                gap: sameRow ? Math.round(c.box.left - a.box.right - a.ringPx - c.ringPx) : null,
              }
            })(),
            ownedLinks: [...document.querySelectorAll('#question-text button[data-owner]')]
              .map(b => [b.dataset.owner, getComputedStyle(b).textDecorationColor]),
            answerBadges: document.querySelectorAll('.mq-choices .mq-player-badge').length,
            badges: [...document.querySelectorAll('#question-text .mq-player-badge')]
              .map(b => [b.textContent.trim(), getComputedStyle(b).backgroundColor, b.getBoundingClientRect().width > 0]),
          }
        }"""
    )


# The fixture formats: "Layout check" is also the start of "Layout check pictures".
FIXTURE_LINK = "a:has-text('Layout check'):not(:has-text('Layout check pictures'))"
PICTURES_LINK = "a:has-text('Layout check pictures')"
DUEL_LINK = "a:has-text('LP duel fixture')"


def start_game(page):
    """Opens the Layout check format, names two players and starts; the board is up."""
    page.goto(base + "/")
    page.locator(FIXTURE_LINK).first.click()
    page.wait_for_selector("#start-game")
    for i in range(2):
        # real key events: the field debounces, and the form reads it on blur
        page.click(f"#player-name-{i}")
        page.keyboard.type(f"Player {i + 1}", delay=20)
        page.keyboard.press("Tab")
    page.wait_for_timeout(600)
    page.click("#start-game")
    page.wait_for_selector("button[phx-click='choose']")


def choices_state(page):
    return page.evaluate(
        """() => {
          const box = document.querySelector('.mq-choices'), first = document.querySelector('#choice-0')
          const bar = document.querySelector('.mq-passbar')
          return {
            enabled: !first.disabled,
            locked: getComputedStyle(first).pointerEvents === 'none',
            dimmed: parseFloat(getComputedStyle(box).opacity) < 1,
            cursor: getComputedStyle(box).cursor,
            barOpacity: parseFloat(getComputedStyle(bar).opacity),
            barHeight: Math.round(bar.getBoundingClientRect().height),
            barTop: Math.round(bar.getBoundingClientRect().top),
            choiceTop: Math.round(first.getBoundingClientRect().top),
            timer: Math.round(document.querySelector('.mq-passbar__timer').getBoundingClientRect().height),
          }
        }"""
    )


def pass_bar_height(page):
    return page.evaluate("() => Math.round(document.querySelector('.mq-passbar').getBoundingClientRect().height)")


with sync_playwright() as p:
    browser = p.chromium.launch()
    _new_context = browser.new_context

    def themed_context(**kw):
        ctx = _new_context(**kw)
        if THEME:
            ctx.add_init_script(f"localStorage.setItem('phx:theme', '{THEME}')")
        return ctx

    browser.new_context = themed_context
    page = browser.new_context(viewport={"width": 390, "height": 844}).new_page()

    start_game(page)

    print("Board")
    for name, w, h, _, _ in VIEWPORTS:
        page.set_viewport_size({"width": w, "height": h})
        page.wait_for_timeout(150)
        m = metrics(page)
        check(f"{name}: no horizontal overflow, score line shown",
              m["overX"] <= 0 and m["score"], f"overflow {m['overX']}px, score line {m['score']}")
        # images load lazily after a resize or a reconnect: wait for them instead of sampling once
        pics_js = """() => {
              const a = [...document.querySelectorAll('img[src^="/images/avatars/"]')]
              return {n: a.length, notLoaded: a.filter(i => !(i.complete && i.naturalWidth > 0)).length}
            }"""
        try:
            page.wait_for_function(f"(() => {{ const m = ({pics_js})(); return m.n >= 2 && m.notLoaded === 0 }})()", timeout=5000)
        except PlaywrightTimeout:
            pass
        pics = page.evaluate(pics_js)
        check(f"{name}: the players' pictures are shown and loaded", pics["n"] >= 2 and pics["notLoaded"] == 0, str(pics))

    # the first question of the board has 4 cards
    page.set_viewport_size({"width": 768, "height": 1024})
    page.locator("button[phx-click='choose']:not([disabled])").first.click()
    page.wait_for_selector("#question-cards article")

    print("Pass the device (first player)")
    check("the bar is full size when the question comes up", pass_bar_height(page) >= 60,
          f"{pass_bar_height(page)}px")
    # a tablet: the bar folds, so the choices wait, and say so. Measured past the
    # server's 700 ms turn guard, which disables the buttons on its own at first
    page.wait_for_timeout(1000)
    st = choices_state(page)
    check("the server's turn guard is over, so the lock is the CSS's own", st["enabled"], str(st))
    check("the choices are locked, dimmed, with a not-allowed pointer and a running line",
          st["locked"] and st["dimmed"] and st["cursor"] == "not-allowed" and st["timer"] > 0, str(st))
    page.wait_for_timeout(2400)
    st = choices_state(page)
    check("after 3 seconds (3.4 s measured) the bar is gone and the choices are free",
          st["barHeight"] <= 2 and not st["locked"] and not st["dimmed"] and st["cursor"] != "not-allowed", str(st))
    page.wait_for_timeout(1600)
    check("it folds away by itself after a few seconds", pass_bar_height(page) <= 50,
          f"{pass_bar_height(page)}px")

    print("Question view")
    for name, w, h, per_row, max_scroll in VIEWPORTS:
        page.set_viewport_size({"width": w, "height": h})
        page.wait_for_timeout(200)
        m = metrics(page)
        check(f"{name}: no horizontal overflow", m["overX"] <= 0, f"{m['overX']}px")
        check(f"{name}: {per_row} cards per row", m["perRow"] >= per_row, f"{m['perRow']}")
        large = is_large(w, h)
        check(f"{name}: {'player list with the question' if large else 'no score line'}", m["score"] == large,
              f"shown {m['score']}")
        check(f"{name}: the page grows with the screen (root font {m['rootFont']:.1f}px)",
              abs(m["rootFont"] - root_font(w, h)) < 0.5)
        if large:
            check(f"{name}: the pass-the-device bar stays", pass_bar_height(page) >= 60, f"{pass_bar_height(page)}px")
        check(f"{name}: cards of P1 and P2 have a blue and a red ring with a glow, and a badge inside the screen",
              m["owned"]["cards"] == [["1", "rgb(37, 99, 235)", "37, 99, 235", True, True, True],
                                      ["2", "rgb(220, 38, 38)", "220, 38, 38", True, True, True]], str(m["owned"]["cards"]))
        check(f"{name}: the two rings do not touch (at least 3px apart)",
              m["owned"]["gap"] is not None and m["owned"]["gap"] >= 3, str(m["owned"]["gap"]))
        check(f"{name}: their links in the text are blue and red",
              m["ownedLinks"] == [["1", "rgb(37, 99, 235)"], ["2", "rgb(220, 38, 38)"]], str(m["ownedLinks"]))
        check(f"{name}: the answer has its P2 badge", m["answerBadges"] == 1, str(m["answerBadges"]))
        check(f"{name}: P1 blue and P2 red badges shown",
              m["badges"] == [["P1", "rgb(37, 99, 235)", True], ["P2", "rgb(220, 38, 38)", True]],
              str(m["badges"]))
        expected = "none" if h <= 920 else "block"
        check(f"{name}: top bar {'hidden' if h <= 920 else 'shown'}", m["header"] == expected,
              f"display {m['header']}")
        check(f"{name}: scrolls at most {max_scroll}px (now {m['overY']}px)", m["overY"] <= max_scroll)

    print("Pass the device (next player)")
    page.set_viewport_size({"width": 390, "height": 844})
    page.click("#choice-0")
    page.wait_for_selector("#answer-progress:has-text('2/2')")
    check("the bar is full size again for the next player", pass_bar_height(page) >= 60,
          f"{pass_bar_height(page)}px")
    page.wait_for_timeout(5000)
    check("and folds away again", pass_bar_height(page) <= 50, f"{pass_bar_height(page)}px")

    print("Suggestion form (answer fields)")
    page.goto(base + "/suggest")
    page.wait_for_selector("#suggest-format")
    page.wait_for_selector("[data-phx-main].phx-connected")  # the select needs the socket
    page.select_option("#suggest-format", label="Layout check")
    page.wait_for_selector("#card-date-note")
    for name, w, h, _, _ in VIEWPORTS:
        page.set_viewport_size({"width": w, "height": h})
        page.fill("#submission_choices_0_text", "")
        page.click("#submission_choices_0_text")
        page.keyboard.type("[Layout Ca", delay=15)
        page.wait_for_timeout(500)  # longer than the hook's pause: a list would be open by now
        m = page.evaluate(
            """() => {
              const d = document.documentElement
              return {
                overX: d.scrollWidth - d.clientWidth,
                lists: document.querySelectorAll('[id^=choice-suggestions]').length,
                hooked: document.querySelectorAll('#suggest-form input[phx-hook]').length,
                hint: !!document.getElementById('choice-hint'),
              }
            }"""
        )
        check(f"{name}: answers have no card list, the hint shows, no horizontal overflow",
              m["overX"] <= 0 and m["lists"] == 0 and m["hooked"] == 0 and m["hint"], str(m))

    for w, h in [(1920, 1080), (1920, 950)]:  # a full screen, and a browser window on it
        print(f"Pass the device (large screen {w}x{h}: nothing moves, nothing is locked)")
        page.set_viewport_size({"width": w, "height": h})
        start_game(page)
        page.locator("button[phx-click='choose']:not([disabled])").first.click()
        page.wait_for_selector("#question-cards article")
        # past the server's short double-tap guard of a new turn (700 ms) and the question's
        # pop-in, which scales the page for a moment
        page.wait_for_timeout(900)
        before = choices_state(page)
        check("the choices can be used right away, no dimming, no running line",
              not before["locked"] and not before["dimmed"] and before["timer"] == 0, str(before))
        check("the bar is shown at first", before["barOpacity"] == 1 and before["barHeight"] >= 60, str(before))
        page.wait_for_timeout(2700)
        after = choices_state(page)
        check("after 3 seconds the bar has faded out (3.6 s measured) where it was",
              after["barOpacity"] == 0 and after["barHeight"] == before["barHeight"], str(after))
        check("and nothing moved: the choices are where they were",
              after["choiceTop"] == before["choiceTop"] and after["barTop"] == before["barTop"], f"{before} / {after}")

    print("Pass the device (large screen, a new game)")
    # a fresh turn at the size of a browser window on a 1080p monitor: the bar and the
    # player list are there after 5 seconds, for the first player and for the next
    page.set_viewport_size({"width": 1920, "height": 950})
    start_game(page)
    page.locator("button[phx-click='choose']:not([disabled])").first.click()
    page.wait_for_selector("#question-cards article")
    page.wait_for_timeout(5000)
    check("first player: the bar has not folded away", pass_bar_height(page) >= 60, f"{pass_bar_height(page)}px")
    check("first player: the player list is with the question",
          page.evaluate("getComputedStyle(document.querySelector('#scoreboard')).display") != "none")
    page.click("#choice-0")
    page.wait_for_selector("#answer-progress:has-text('2/2')")
    page.wait_for_timeout(5000)
    check("next player: the bar has not folded away either", pass_bar_height(page) >= 60,
          f"{pass_bar_height(page)}px")

    # The picture buttons of the new-game page. A touch context (coarse pointer), as on a phone or
    # tablet. The Layout check format has no admin-chosen cards, so these are the monster pictures
    # of the date's / default pool; the card pictures use the same markup.
    print("New game page (the players' picture buttons and panel)")
    touch = browser.new_context(viewport={"width": 390, "height": 844}, has_touch=True, is_mobile=True)
    tpage = touch.new_page()
    tpage.goto(base + "/")
    tpage.locator(FIXTURE_LINK).first.click()
    tpage.wait_for_selector("#avatar-button-0")
    tpage.wait_for_selector("[data-phx-main].phx-connected")
    check("the touch context has a coarse pointer", tpage.evaluate("matchMedia('(pointer: coarse)').matches"))

    def picture_metrics(pg):
        return pg.evaluate(
            """() => {
              const d = document.documentElement
              const rect = (e) => e.getBoundingClientRect()
              const btns = [...document.querySelectorAll('[id^=avatar-button-]')]
              const panel = document.querySelector('#avatar-panel-0')
              const grid = panel && panel.querySelector('[role=group]')
              const choices = panel ? [...panel.querySelectorAll('[id^=avatar-choice-]')] : []
              return {
                overX: d.scrollWidth - d.clientWidth,
                overY: d.scrollHeight - innerHeight,
                buttons: btns.map(b => [Math.round(rect(b).width), Math.round(rect(b).height)]),
                src: btns.length ? btns[0].querySelector('img').getAttribute('src') : null,
                panelIn: panel ? rect(panel).left >= 0 && rect(panel).right <= innerWidth : null,
                gridMax: grid ? grid.clientHeight <= 14 * parseFloat(getComputedStyle(d).fontSize) + 1 : null,
                gridScrolls: grid ? getComputedStyle(grid).overflowY : null,
                choices: choices.length,
                smallest: choices.length ? Math.round(Math.min(...choices.map(c => Math.min(rect(c).width, rect(c).height)))) : null,
                inputIn: (() => { const i = document.querySelector('#player-name-0').getBoundingClientRect(); return i.width >= 100 && i.right <= innerWidth })(),
              }
            }"""
        )

    for name, w, h, _, _ in VIEWPORTS:
        tpage.set_viewport_size({"width": w, "height": h})
        tpage.wait_for_timeout(150)
        closed = picture_metrics(tpage)
        check(f"{name}: picture buttons are at least 44x44, the name field keeps room, no horizontal overflow",
              len(closed["buttons"]) == 2 and all(bw >= 44 and bh >= 44 for bw, bh in closed["buttons"])
              and closed["inputIn"] and closed["overX"] <= 0, str(closed))
        tpage.click("#avatar-button-0")
        tpage.wait_for_selector("#avatar-panel-0")
        opened = picture_metrics(tpage)
        check(f"{name}: the open panel fits the width, its grid is capped and scrolls inside, targets are >= 44px",
              opened["overX"] <= 0 and opened["panelIn"] and opened["gridMax"] and opened["gridScrolls"] == "auto"
              and opened["choices"] >= 8 and opened["smallest"] >= 44, str(opened))
        tpage.click("#avatar-choice-0-" + tpage.evaluate(
            "() => [...document.querySelectorAll('[id^=avatar-choice-0-]:not([disabled]):not([aria-pressed=true])')][0].id.slice('avatar-choice-0-'.length)"))
        tpage.wait_for_selector("#avatar-panel-0", state="detached")
        after = picture_metrics(tpage)
        check(f"{name}: choosing a picture changes the button's image and closes the panel",
              after["src"] != opened["src"] and after["overX"] <= 0, f"{opened['src']} -> {after['src']}")
        check(f"{name}: the closed page scrolls no further than before the buttons (now {closed['overY']}px)",
              closed["overY"] <= 700 and after["overY"] <= closed["overY"] + 2, f"{closed['overY']} / {after['overY']}")

    # The same page for a format whose admin list has cards (Layout check pictures, 5 cards with a
    # generated artwork): the pictures are the cards' artworks, zoomed into a circle.
    print("New game page, a format with admin-chosen cards")
    tpage.goto(base + "/")
    tpage.locator(PICTURES_LINK).first.click()
    tpage.wait_for_selector("#avatar-button-0")
    tpage.wait_for_selector("[data-phx-main].phx-connected")
    card_js = """() => {
          const a = [...document.querySelectorAll('[id^=avatar-button-] img')]
          return {n: a.length, cards: a.filter(i => i.getAttribute('src').startsWith('/cards/')).length,
                  notLoaded: a.filter(i => !(i.complete && i.naturalWidth > 0)).length}
        }"""
    try:
        tpage.wait_for_function(f"(() => {{ const m = ({card_js})(); return m.n >= 2 && m.notLoaded === 0 }})()", timeout=5000)
    except PlaywrightTimeout:
        pass
    pics = tpage.evaluate(card_js)
    check("the players' pictures are cards of the list, and loaded", pics["n"] >= 2 and pics["cards"] == pics["n"] and pics["notLoaded"] == 0, str(pics))
    tpage.click("#avatar-button-0")
    tpage.wait_for_selector("#avatar-panel-0")
    for name, w, h, _, _ in VIEWPORTS:
        tpage.set_viewport_size({"width": w, "height": h})
        tpage.wait_for_timeout(150)
        m = tpage.evaluate(
            """() => {
              const d = document.documentElement, panel = document.querySelector('#avatar-panel-0')
              const choices = [...panel.querySelectorAll('[id^=avatar-choice-0-]')]
              const r = panel.getBoundingClientRect()
              return {choices: choices.length, overX: d.scrollWidth - d.clientWidth,
                      inside: r.left >= 0 && r.right <= innerWidth,
                      small: choices.filter(c => { const b = c.getBoundingClientRect(); return b.width < 44 || b.height < 44 }).length,
                      clipped: panel.querySelectorAll('img').length}
            }"""
        )
        check(f"{name}: all 5 cards are offered, 44px or more, inside the screen, no horizontal overflow",
              m["choices"] == 5 and m["small"] == 0 and m["inside"] and m["overX"] <= 0, str(m))
    touch.close()

    # The admin form: the attached cards can be moved up and down. Needs an admin login (CI has
    # one from the release's ADMIN_*: SMOKE_ADMIN_USER / SMOKE_ADMIN_PASSWORD), else it is skipped.
    if os.environ.get("SMOKE_ADMIN_USER") and os.environ.get("SMOKE_ADMIN_PASSWORD"):
        print("Admin form (the order of a question's cards)")
        page.set_viewport_size({"width": 1280, "height": 900})
        page.goto(base + "/admin/login")
        # the form is a LiveView: what is typed before it connects is lost
        page.wait_for_selector("[data-phx-main].phx-connected")
        page.fill("#login-form input[name='user[username]']", os.environ["SMOKE_ADMIN_USER"])
        page.fill("#login-form input[name='user[password]']", os.environ["SMOKE_ADMIN_PASSWORD"])
        page.click("#login-submit")
        page.wait_for_url("**/admin/formats")
        page.locator(FIXTURE_LINK).first.click()
        # the question rows: a damage badge (ATK) that follows the position, nothing runs off the screen
        def row_state():
            return page.evaluate(
                """() => {
                  const rows = [...document.querySelectorAll('li[id^=question-]')]
                  const badges = rows.map(li => li.querySelector('.badge')?.textContent.trim())
                  return {
                    n: rows.length,
                    atk: badges.filter(b => /^[0-9]+ ATK$/.test(b || '')).length,
                    first: badges[0],
                    overX: document.documentElement.scrollWidth - document.documentElement.clientWidth,
                    inside: rows.every(li => { const r = li.getBoundingClientRect(); return r.left >= 0 && r.right <= innerWidth }),
                  }
                }"""
            )

        for name, w, h, _, _ in VIEWPORTS:
            page.set_viewport_size({"width": w, "height": h})
            page.wait_for_timeout(150)
            r = row_state()
            check(f"{name}: admin question rows show an ATK badge each, on screen, no horizontal overflow",
                  r["n"] > 0 and r["atk"] == r["n"] and r["first"] == "100 ATK" and r["overX"] <= 0 and r["inside"], str(r))
        page.set_viewport_size({"width": 1280, "height": 900})

        # the question with 4 cards (the fixture's first one), found by its text
        page.locator("li[id^='question-']", has_text="look at four cards").locator("a[id^='edit-question-']").click()
        page.wait_for_selector("#selected-cards li")

        # the fixed damage is a note, there is no points field any more
        for name, w, h, _, _ in VIEWPORTS:
            page.set_viewport_size({"width": w, "height": h})
            page.wait_for_timeout(100)
            f = page.evaluate(
                """() => {
                  const n = document.querySelector('#question-damage-note')
                  const r = n && n.getBoundingClientRect()
                  return {
                    note: n ? n.textContent.trim().replace(/[ \\n]+/g, ' ') : null,
                    points: document.querySelectorAll("input[name='question[points]']").length,
                    inside: !!r && r.left >= 0 && r.right <= innerWidth,
                    overX: document.documentElement.scrollWidth - document.documentElement.clientWidth,
                  }
                }"""
            )
            check(f"{name}: admin question form has the fixed-damage note (no points field), on screen, no horizontal overflow",
                  f["note"] is not None and "LP, fixed by the question's position" in f["note"] and f["points"] == 0
                  and f["inside"] and f["overX"] <= 0, str(f))
        page.set_viewport_size({"width": 1280, "height": 900})

        def card_order():
            return page.evaluate("() => [...document.querySelectorAll('#selected-cards > li')].map(li => li.id)")

        def move_state():
            return page.evaluate(
                """() => {
                  const btns = [...document.querySelectorAll('#selected-cards [id^=move-card-]')]
                  const names = [...document.querySelectorAll('#selected-cards li p.font-semibold')]
                  return {
                    n: btns.length,
                    inside: btns.every(b => { const r = b.getBoundingClientRect(); return r.width > 0 && r.left >= 0 && r.right <= innerWidth }),
                    overX: document.documentElement.scrollWidth - document.documentElement.clientWidth,
                    nameWidth: Math.round(Math.min(...names.map(n => n.getBoundingClientRect().width))),
                  }
                }"""
            )

        for name, w, h, _, _ in VIEWPORTS:
            page.set_viewport_size({"width": w, "height": h})
            page.wait_for_timeout(150)
            m = move_state()
            check(f"{name}: 4 cards have up and down buttons (8), all on screen, no horizontal overflow, "
                  f"the names keep room (>= 60px)",
                  m["n"] == 8 and m["inside"] and m["overX"] <= 0 and m["nameWidth"] >= 60, str(m))

        before = card_order()
        check("the first card cannot go up, the last cannot go down",
              page.locator(f"#move-card-{before[0].split('-')[-1]}-up").is_disabled()
              and page.locator(f"#move-card-{before[-1].split('-')[-1]}-down").is_disabled())
        def waits(js, arg, label):
            # a move that never shows is a failed check, not a crash that loses the summary
            try:
                page.wait_for_function(js, arg=arg, timeout=5000)
                return True
            except PlaywrightTimeout:
                check(label, False, "the list did not change within 5 s")
                return False

        for w, h in [(768, 1024), (390, 844)]:  # a tablet, a phone
            page.set_viewport_size({"width": w, "height": h})
            first = card_order()[0].split("-")[-1]
            page.click(f"#move-card-{first}-down")
            if waits("(id) => document.querySelector('#selected-cards > li').id !== 'selected-card-' + id", first,
                     f"{w}x{h}: moving the first card down puts it second"):
                after = card_order()
                check(f"{w}x{h}: moving the first card down puts it second", after[1] == f"selected-card-{first}", str(after))
                page.click(f"#move-card-{first}-up")
                if waits("(id) => document.querySelector('#selected-cards > li').id === 'selected-card-' + id", first,
                         f"{w}x{h}: and up again restores the order"):
                    check(f"{w}x{h}: and up again restores the order", card_order() == before, str(card_order()))

        # The profile pictures of a format (the admin page of "Layout check pictures": 5 cards)
        print("Admin format page (profile pictures)")
        page.goto(base + "/admin/formats")
        page.locator(PICTURES_LINK).first.click()
        page.wait_for_selector("#avatar-card-list")
        for name, w, h, _, _ in VIEWPORTS:
            page.set_viewport_size({"width": w, "height": h})
            page.wait_for_timeout(150)
            m = page.evaluate(
                """() => {
                  const d = document.documentElement
                  const btns = [...document.querySelectorAll('#avatar-card-list button')]
                  const sec = document.querySelector('#avatar-cards').getBoundingClientRect()
                  return {n: btns.length, overX: d.scrollWidth - d.clientWidth,
                          inside: sec.left >= 0 && sec.right <= innerWidth,
                          small: btns.filter(b => { const r = b.getBoundingClientRect(); return r.width < 44 || r.height < 44 }).length,
                          count: document.querySelector('#avatar-count').textContent.trim()}
                }"""
            )
            check(f"{name}: the 5 cards' remove and crop buttons (10) are 44px or more, the section fits, no horizontal overflow",
                  m["n"] == 10 and m["small"] == 0 and m["inside"] and m["overX"] <= 0 and m["count"].startswith("5 of"), str(m))

        # The crop editor of the first card: opens, fits every viewport, a click on the artwork
        # moves the focus point, Save changes the picture in the grid and on the new-game page,
        # Reset puts the fixture back (the fixture's cards must end without crops).
        print("Admin format page (crop editor)")
        first_id = page.evaluate("() => document.querySelector('#avatar-card-list li').id.replace('avatar-card-', '')")
        grid_img = f"#avatar-card-{first_id} img"

        def img_box(selector):
            st = page.eval_on_selector(selector, "e => e.getAttribute('style')")
            import re
            vals = {k: float(v) for k, v in re.findall(r"(width|left|top):(-?[\d.]+)%", st)}
            return vals

        def reset_crop():
            page.goto(base + "/admin/formats")
            page.locator(PICTURES_LINK).first.click()
            page.wait_for_selector("#avatar-card-list")
            page.click(f"#crop-avatar-{first_id}")
            page.wait_for_selector("#crop-editor")
            page.click("#crop-reset")
            page.wait_for_selector("#crop-editor", state="detached")

        try:
            page.set_viewport_size({"width": 1280, "height": 900})
            check("the grid starts without a crop (width 150%)", img_box(grid_img)["width"] == 150.0, str(img_box(grid_img)))
            page.click(f"#crop-avatar-{first_id}")
            page.wait_for_selector("#crop-editor")
            page.wait_for_function("() => { const i = document.querySelector('#crop-artwork img'); return i.complete && i.naturalWidth > 0 }")
            for i, (name, w, h, _, _) in enumerate(VIEWPORTS):
                page.set_viewport_size({"width": w, "height": h})
                page.wait_for_timeout(200)
                page.evaluate("() => document.querySelector('#crop-artwork').scrollIntoView({block: 'center'})")
                m = page.evaluate(
                    """() => {
                      const d = document.documentElement
                      const box = (el) => { const r = el.getBoundingClientRect(); return {w: r.width, h: r.height, l: r.left, r: r.right} }
                      const art = box(document.querySelector('#crop-artwork'))
                      const ctl = [...document.querySelectorAll('#crop-form input[type=range], #crop-save, #crop-reset, #crop-cancel')].map(box)
                      const prev = [...document.querySelectorAll('#crop-previews > span')].map(e => ({...box(e), br: getComputedStyle(e).borderRadius}))
                      return {overX: d.scrollWidth - d.clientWidth, art, vw: innerWidth, nctl: ctl.length,
                              short: ctl.filter(b => b.h < 44).length, outside: ctl.filter(b => b.l < 0 || b.r > innerWidth).length,
                              artLoaded: document.querySelector('#crop-artwork img').naturalWidth > 0,
                              prev: prev.map(p => [Math.round(p.w * 10) / 10, Math.round(p.h * 10) / 10, p.br])}
                    }"""
                )
                art = m["art"]
                check(f"{name}: the crop editor fits the width (no horizontal overflow), the artwork is a square of "
                      f">= 200px inside the screen",
                      m["overX"] <= 0 and abs(art["w"] - art["h"]) <= 1 and art["w"] >= 200 and art["l"] >= 0
                      and art["r"] <= m["vw"] and m["artLoaded"], str(m))
                check(f"{name}: 3 sliders and Save, Reset, Cancel are 44px tall or more and inside the screen",
                      m["nctl"] == 6 and m["short"] == 0 and m["outside"] == 0, str(m))
                check(f"{name}: the 3 previews are round (width == height, a radius)",
                      len(m["prev"]) == 3 and all(abs(p[0] - p[1]) < 0.6 and p[2] != "0px" for p in m["prev"]), str(m["prev"]))
                # a click at a known point of the artwork moves the sliders (a different point per viewport)
                fx, fy = 0.15 + (i * 7 % 70) / 100, 0.2 + (i * 11 % 60) / 100
                bb = page.locator("#crop-artwork").bounding_box()
                page.mouse.click(bb["x"] + fx * bb["width"], bb["y"] + fy * bb["height"])
                # at the default zoom of 150 % the circle stops at a focus of 33 and 67, so do the sliders
                want_x, want_y = (min(67, max(33, round(v * 100))) for v in (fx, fy))
                try:
                    page.wait_for_function(
                        "([x, y]) => Math.abs(document.querySelector('#crop-x').value - x) <= 2 && Math.abs(document.querySelector('#crop-y').value - y) <= 2",
                        arg=[want_x, want_y], timeout=3000)
                except PlaywrightTimeout:
                    pass
                got = page.evaluate("() => [document.querySelector('#crop-x').value, document.querySelector('#crop-y').value]")
                check(f"{name}: a click at {round(fx * 100)}%,{round(fy * 100)}% of the artwork sets the sliders to it (within 33..67)",
                      abs(int(got[0]) - want_x) <= 2 and abs(int(got[1]) - want_y) <= 2, f"{got} wanted {[want_x, want_y]}")

            # zoom to 250 with the slider (the keyboard fallback), then save
            page.set_viewport_size({"width": 390, "height": 844})
            page.evaluate(
                """() => { const z = document.querySelector('#crop-zoom'); z.value = 250
                          z.dispatchEvent(new Event('input', {bubbles: true})) }""")
            page.wait_for_function("() => document.querySelector('#crop-previews span:last-child img').getAttribute('style').startsWith('width:250')")
            page.click("#crop-save")
            page.wait_for_selector("#crop-editor", state="detached")
            saved = img_box(grid_img)
            check("saving changes the grid picture (width 250%, shifted left and up)",
                  saved["width"] == 250.0 and saved["left"] < 0 and saved["top"] < 0, str(saved))

            # the player page: the picker shows the saved crop
            page.goto(base + "/")
            page.locator(PICTURES_LINK).first.click()
            page.wait_for_selector("#avatar-button-0")
            page.wait_for_selector("[data-phx-main].phx-connected")
            page.click("#avatar-button-0")
            page.wait_for_selector("#avatar-panel-0")
            shown = img_box(f"#avatar-choice-0-card-{first_id} img")
            check("the new-game picker shows the saved crop (same width and offsets)",
                  shown == saved, f"{shown} / {saved}")
        finally:
            reset_crop()
        page.wait_for_selector("#avatar-card-list")
        check("Reset puts the grid picture back (width 150%)", img_box(grid_img)["width"] == 150.0, str(img_box(grid_img)))
        # Every admin page at every viewport (a touch context up to 1180px wide, else a mouse one): nothing
        # runs off the screen sideways, every button, link and field a finger can hit is 44px or more
        # (the site's top bar is the player-facing chrome and not counted; a checkbox counts by its label),
        # no text is cut off (no ellipsis, no clamp, no clipped box).
        print("Admin pages (tap targets, wrapping, no horizontal overflow)")
        # log in once (the login is rate limited) and reuse the session in both contexts
        admin_state = page.context.storage_state()
        touch_ctx = browser.new_context(viewport={"width": 390, "height": 844}, has_touch=True, is_mobile=True, storage_state=admin_state)
        mouse_ctx = browser.new_context(viewport={"width": 1280, "height": 900}, storage_state=admin_state)
        ctxs = {"touch": touch_ctx.new_page(), "mouse": mouse_ctx.new_page()}
        # the URLs of the fixture format and of its four-card question
        pg = ctxs["mouse"]
        pg.goto(base + "/admin/formats")
        fixture_url = pg.locator(FIXTURE_LINK).first.get_attribute("href")
        pictures_url = pg.locator(PICTURES_LINK).first.get_attribute("href")
        pg.goto(base + fixture_url)
        question_url = pg.locator("li[id^='question-']", has_text="look at four cards").locator("a[id^='edit-question-']").get_attribute("href")
        admin_pages = [
            ("formats", "/admin/formats", "#formats a"),
            ("new format", "/admin/formats/new", "#format-form"),
            ("format", fixture_url, "li[id^=question-]"),
            ("format edit", fixture_url + "/edit", "#format-form"),
            ("format pictures", pictures_url, "#avatar-cards"),
            ("question", question_url, "#selected-cards li"),
            ("suggestions", "/admin/submissions", "#submission-filters"),
            ("admins", "/admin/users", "#new-user-form"),
            ("backup", "/admin/backup", "#restore-form"),
        ]
        AUDIT = """() => {
          const d = document.documentElement
          const vis = (e) => { const r = e.getBoundingClientRect(); return r.width > 0 && r.height > 0 && getComputedStyle(e).visibility !== 'hidden' }
          const targets = [...document.querySelectorAll('a[href], button, summary, select, textarea, input:not([type=hidden]):not([type=checkbox]):not([type=radio]), .tab')]
            .filter(e => vis(e) && !e.closest('#site-header') && !e.closest('.sr-only') && !e.classList.contains('sr-only'))
          // a checkbox is hit through its label
          const boxes = [...document.querySelectorAll('input[type=checkbox]')].filter(vis)
            .map(e => e.closest('label') || e)
          const small = [...targets, ...boxes].filter(e => { const r = e.getBoundingClientRect(); return r.height < 43.5 || r.width < 43.5 })
          // wide inputs and links inside a sentence are exempt only by being inline text, not here: every
          // listed element is a control
          const cut = [...document.querySelectorAll('main p, main h1, main h2, main h3, main li, main span')].filter(vis).filter(e => {
            const cs = getComputedStyle(e)
            return cs.textOverflow === 'ellipsis' || cs.webkitLineClamp !== 'none'
              || (cs.overflowY !== 'visible' && e.scrollHeight > e.clientHeight + 1 && e.children.length === 0 && !e.closest('.overflow-y-auto'))
          })
          return {overX: d.scrollWidth - d.clientWidth,
                  small: small.slice(0, 4).map(e => (e.id || e.tagName + '.' + String(e.className).slice(0, 25)) + ' ' + Math.round(e.getBoundingClientRect().width) + 'x' + Math.round(e.getBoundingClientRect().height)),
                  nsmall: small.length,
                  cut: cut.slice(0, 3).map(e => (e.id || e.tagName + '.' + String(e.className).slice(0, 25)))}
        }"""
        for name, w, h, _, _ in VIEWPORTS:
            pg = ctxs["touch" if w <= 1180 else "mouse"]
            pg.set_viewport_size({"width": w, "height": h})
            for label, url, ready in admin_pages:
                pg.goto(base + url)
                pg.wait_for_selector(ready)
                pg.wait_for_selector("[data-phx-main].phx-connected")
                pg.wait_for_timeout(100)
                a = pg.evaluate(AUDIT)
                touch_vp = w <= 1180
                ok = a["overX"] <= 0 and not a["cut"] and (not touch_vp or a["nsmall"] == 0)
                check(f"{name}: admin {label}: no horizontal overflow, no cut-off text"
                      + (", every control 44px or more" if touch_vp else ""), ok, str(a))
        # a long question text wraps in the format page's row: the whole text is shown, the row grows
        long_text = "A very long question text that must wrap over several lines and never be cut off, " * 12
        for name, w, h, _, _ in VIEWPORTS:
            pg = ctxs["touch" if w <= 1180 else "mouse"]
            pg.set_viewport_size({"width": w, "height": h})
            pg.goto(base + fixture_url)
            pg.wait_for_selector("li[id^=question-]")
            r = pg.evaluate(
                """(t) => {
                  const p = document.querySelector('li[id^=question-] p')
                  p.textContent = t
                  const cs = getComputedStyle(p), r = p.getBoundingClientRect(), li = p.closest('li').getBoundingClientRect()
                  const lh = parseFloat(cs.lineHeight) || 20
                  return {ellipsis: cs.textOverflow, clamp: cs.webkitLineClamp, fits: p.scrollHeight <= p.clientHeight + 1,
                          lines: Math.round(r.height / lh), inside: r.left >= 0 && r.right <= innerWidth && li.right <= innerWidth,
                          overX: document.documentElement.scrollWidth - document.documentElement.clientWidth}
                }""", long_text)
            check(f"{name}: a long question text in the admin row wraps over several lines, is not clipped or ellipsised",
                  r["ellipsis"] != "ellipsis" and r["clamp"] == "none" and r["fits"] and r["lines"] >= 3 and r["inside"] and r["overX"] <= 0,
                  str(r))
        touch_ctx.close()
        mouse_ctx.close()
    elif os.environ.get("LAYOUT_REQUIRE_ADMIN"):
        # CI sets it: a section that is skipped for a missing login would leave the run green untested
        print("Admin form")
        check("the admin login is there (SMOKE_ADMIN_USER, SMOKE_ADMIN_PASSWORD)", False, "not set")
    else:
        print("Admin form: skipped (set SMOKE_ADMIN_USER and SMOKE_ADMIN_PASSWORD to run it)")

    # The life-point duel (format "LP duel fixture": 2 topics of 6 questions, 100 up to 3000 damage), on a
    # touch context. Free mode and Level Up!, 2 to 4 players.
    print("Life-point duel")
    duel = browser.new_context(viewport={"width": 390, "height": 844}, has_touch=True, is_mobile=True)
    dpage = duel.new_page()

    def start_duel(pg, players, mode="free", lp=None):
        pg.goto(base + "/")
        pg.locator(DUEL_LINK).first.click()
        pg.wait_for_selector("#start-game")
        pg.wait_for_selector("[data-phx-main].phx-connected")
        for n in range(2, players):
            pg.click("#add-player")
            pg.wait_for_selector(f"#player-row-{n}")
        for i in range(players):
            pg.fill(f"#player-name-{i}", f"Player {i + 1}")
            pg.keyboard.press("Tab")
        pg.wait_for_timeout(600)
        if mode != "free":
            pg.click(f"#mode-{mode}")
        if lp:
            pg.click(f"#lp-choice-{lp}")
        pg.click("#start-game")
        pg.wait_for_selector("#board")

    def sideways(pg):
        return pg.evaluate("() => document.documentElement.scrollWidth - document.documentElement.clientWidth")

    # the new-game page: both life-point cards, 44px or more, inside the screen, 4000 chosen
    dpage.goto(base + "/")
    dpage.locator(DUEL_LINK).first.click()
    dpage.wait_for_selector("#lp-choice-4000")
    dpage.wait_for_selector("[data-phx-main].phx-connected")
    for name, w, h, _, _ in VIEWPORTS:
        dpage.set_viewport_size({"width": w, "height": h})
        dpage.wait_for_timeout(150)
        m = dpage.evaluate(
            """() => {
              const boxes = ['#lp-choice-4000', '#lp-choice-8000'].map(s => document.querySelector(s).getBoundingClientRect())
              return {overX: document.documentElement.scrollWidth - document.documentElement.clientWidth,
                      small: boxes.filter(b => b.height < 44 || b.width < 44).length,
                      outside: boxes.filter(b => b.left < 0 || b.right > innerWidth).length,
                      default4000: document.querySelector('#lp-choice-4000 input').checked}
            }"""
        )
        check(f"{name}: the Life Points choice has two cards of 44px or more inside the screen, 4000 chosen, no horizontal overflow",
              m["small"] == 0 and m["outside"] == 0 and m["default4000"] and m["overX"] <= 0, str(m))
    dpage.click("#lp-choice-8000")
    check("a tap on 8000 chooses it", dpage.evaluate("document.querySelector('#lp-choice-8000 input').checked"))

    # the board with 2, 3 and 4 players: every player's life points and bar are on screen
    for players in (2, 3, 4):
        dpage.set_viewport_size({"width": 390, "height": 844})
        start_duel(dpage, players)
        for name, w, h, _, _ in VIEWPORTS:
            dpage.set_viewport_size({"width": w, "height": h})
            dpage.wait_for_timeout(150)
            m = dpage.evaluate(
                """(n) => {
                  const rows = [...Array(n).keys()].map(i => ({
                    row: document.querySelector('#score-' + i), lp: document.querySelector('#lp-' + i),
                    bar: document.querySelector('#lp-bar-' + i)}))
                  const inside = (e) => { const r = e.getBoundingClientRect(); return r.width > 0 && r.left >= 0 && r.right <= innerWidth }
                  return {overX: document.documentElement.scrollWidth - document.documentElement.clientWidth,
                          shown: rows.filter(r => r.row && inside(r.row) && inside(r.lp) && r.bar.getBoundingClientRect().height > 0).length,
                          // a name keeps room for at least 6 letters (the full name is in its title)
                          nameMin: Math.min(...rows.map(r => r.row.querySelector('.duel-gauge-name').getBoundingClientRect().width)),
                          lp: document.querySelector('#lp-0').textContent.trim().replace(/^0+/, ''),
                          tile: document.querySelector('#question-0').textContent.replace(/\s+/g, ' ').trim()}
                }""",
                players,
            )
            check(f"{name}: {players} players: life points and bars on screen, 4000 LP, tile shows its damage, no horizontal overflow",
                  m["shown"] == players and m["lp"] == "4000" and m["nameMin"] >= 44 and m["tile"].endswith("100") and m["overX"] <= 0, str(m))

    # a knock-out: Player 2 is wrong on 3000 and then on 2500 damage
    def answer_round(pg, choose):
        pg.click(choose)
        pg.wait_for_selector("#current-player")
        for _ in range(2):
            who = pg.text_content("#current-player").strip()
            pg.click("#choice-1" if who == "Player 2" else "#choice-0", timeout=15000)
            pg.wait_for_timeout(300)

    dpage.set_viewport_size({"width": 390, "height": 844})
    start_duel(dpage, 2)
    answer_round(dpage, "#question-5")
    dpage.wait_for_selector("#reveal")
    check("a hit that is survived reads LP before - damage = LP after",
          "4000 - 3000 = 1000" in dpage.inner_text("#damage-result-1"), dpage.inner_text("#damage-result-1"))
    dpage.click("#next-round")
    dpage.wait_for_selector("#board")
    answer_round(dpage, "#question-4")
    dpage.wait_for_selector("#reveal")
    for name, w, h, _, _ in VIEWPORTS:
        dpage.set_viewport_size({"width": w, "height": h})
        dpage.wait_for_timeout(150)
        m = dpage.evaluate(
            """() => {
              const ko = document.querySelector('#damage-result-1'), tag = document.querySelector('#ko-1')
              const inside = (e) => { const r = e.getBoundingClientRect(); return r.width > 0 && r.left >= 0 && r.right <= innerWidth }
              const bar = document.querySelector('#next-round').getBoundingClientRect()
              return {overX: document.documentElement.scrollWidth - document.documentElement.clientWidth,
                      ko: !!ko && inside(ko) && ko.textContent.includes('K.O.'), tag: !!tag && inside(tag),
                      button: bar.height >= 44, safe: document.querySelector('#damage-result-0').textContent.includes('No damage')}
            }"""
        )
        check(f"{name}: the K.O. result is on screen with its Eliminated tag, the next button is >= 44px, no horizontal overflow",
              m["ko"] and m["tag"] and m["button"] and m["safe"] and m["overX"] <= 0, str(m))
    dpage.set_viewport_size({"width": 390, "height": 844})
    dpage.click("#next-round")
    dpage.wait_for_selector("#final")
    for name, w, h, _, _ in VIEWPORTS:
        dpage.set_viewport_size({"width": w, "height": h})
        dpage.wait_for_timeout(150)
        check(f"{name}: the final ranking shows the winner and the eliminated player, no horizontal overflow",
              dpage.locator("#winner").inner_text().endswith("wins!") and dpage.locator("#final-eliminated-1").count() == 1
              and sideways(dpage) <= 0, str(sideways(dpage)))

    # Level Up!: the topic buttons say what the next question costs
    dpage.set_viewport_size({"width": 390, "height": 844})
    start_duel(dpage, 4, mode="ascending")
    for name, w, h, _, _ in VIEWPORTS:
        dpage.set_viewport_size({"width": w, "height": h})
        dpage.wait_for_timeout(150)
        m = dpage.evaluate(
            """() => {
              const tops = [...document.querySelectorAll('button[id^=topic-]')]
              const info = tops.map(b => {
                const r = b.getBoundingClientRect(), a = b.querySelector('[id^=next-atk-]').getBoundingClientRect()
                return {w: r.width, h: r.height, text: b.querySelector('[id^=next-atk-]').innerText.replace(/\s+/g, ' ').trim(),
                        within: a.left >= r.left - 0.5 && a.right <= r.right + 0.5 && a.bottom <= r.bottom + 0.5,
                        inside: r.left >= 0 && r.right <= innerWidth}
              })
              return {n: info.length, small: info.filter(i => i.w < 44 || i.h < 44).length,
                      texts: info.map(i => i.text), within: info.every(i => i.within), inside: info.every(i => i.inside),
                      overX: document.documentElement.scrollWidth - document.documentElement.clientWidth}
            }"""
        )
        check(f"{name}: Level Up! topic buttons are 44px or more, show NEXT ATK 100 inside the button, no horizontal overflow",
              m["n"] == 2 and m["small"] == 0 and m["texts"] == ["NEXT ATK 100"] * 2 and m["within"]
              and m["inside"] and m["overX"] <= 0, str(m))
    duel.close()

    browser.close()

print()
print(f"{passed} passed, {failed} failed")
sys.exit(1 if failed else 0)
