#!/usr/bin/env bash
# Posts an evaluated review to its pull request as a comment, so the PR shows
# why changes were made: every finding with the verdict and reason given to it,
# and the commits after the review that address it (commits naming "F<n>").
#
#   bin/review-post <number> [review file] [--dry-run]
#
# The review file defaults to the PR's current review, reviews/pr-<branch>.md,
# or for a merged/closed PR its newest archived one. --dry-run prints the
# comment instead of posting it. After posting, the comment's link is added to
# the review file's header ("- Posted: ...").
set -euo pipefail

usage() { echo "usage: bin/review-post <number> [review file] [--dry-run]" >&2; exit 1; }

number=""
file=""
dry_run=false
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=true ;;
    [0-9]*) [[ -z "$number" ]] && number="$arg" || usage ;;
    *) file="$arg" ;;
  esac
done
[[ "$number" =~ ^[0-9]+$ ]] || usage

root="$(git rev-parse --show-toplevel)"
cd "$root"

branch="$(gh pr view "$number" --json headRefName --jq .headRefName)"
slug="$(printf '%s' "$branch" | sed 's/[^A-Za-z0-9._-]/-/g')"
if [[ -z "$file" ]]; then
  file="reviews/pr-${slug}.md"
  [[ -e "$file" ]] || file="$(ls -t reviews/archive/pr-"${slug}"-[0-9a-f]*.md 2>/dev/null | head -1 || true)"
fi
[[ -n "$file" && -e "$file" ]] || { echo "review-post: no review found for PR #$number" >&2; exit 1; }
grep -q "^- PR: #${number} " "$file" || { echo "review-post: $file is not a review of PR #$number" >&2; exit 1; }

if ! grep -qE '\[[xX]\] (valid|wrong|unsure)' "$file"; then
  echo "review-post: no finding in $file has a verdict yet; tick valid, wrong or unsure first" >&2
  exit 1
fi

commits="$(mktemp)"
body="$(mktemp)"
trap 'rm -f "$commits" "$body"' EXIT
gh pr view "$number" --json commits >"$commits"
bin/review-tools post-body "$file" "$commits" "$(gh api user --jq .login)" >"$body"

if [[ "$dry_run" == true ]]; then
  cat "$body"
  exit 0
fi

url="$(gh pr comment "$number" --body-file "$body")"
sed -i "0,/^- Date: .*/s||&\n- Posted: $(date -u +%Y-%m-%dT%H:%MZ) $url|" "$file"
echo "posted: $url"
