# Gigalixir builds the app with buildpacks (there is no Docker). The same
# Elixir and OTP release as the Dockerfile (which pins the later OTP patch
# 27.3.4.18); if the build says a version is not available, use one from the
# list it prints.
elixir_version=1.17.3
erlang_version=27.3.4

# The libvips NIF of `vix` is downloaded by a tool that cannot follow GitHub's
# redirect (see bin/fetch-vix-nif): fetch it before the dependencies compile.
hook_pre_compile="bin/fetch-vix-nif"

# Tailwind and esbuild come from Hex (no Node): build and digest the assets
# before the release is assembled.
hook_post_compile="bin/build-assets"
